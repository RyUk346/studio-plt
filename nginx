server {
    server_name location.hyperglow.co.uk;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/location.hyperglow.co.uk/fullchai>
    ssl_certificate_key /etc/letsencrypt/live/location.hyperglow.co.uk/priv>
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = location.hyperglow.co.uk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name location.hyperglow.co.uk;
    return 404; # managed by Certbot
}
